{
  "name": "mindmaps-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mindmaps",
    "db:new": "wrangler d1 migrations create mindmaps",
    "db:list": "wrangler d1 migrations list mindmaps --local",
    "db:migrate": "wrangler d1 migrations apply mindmaps --local",
    "db:migrate:remote": "wrangler d1 migrations apply mindmaps --remote",
    "db:seed": "wrangler d1 execute mindmaps --local --file=seed.sql",
    "setup": "node scripts/setup.mjs",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "^4.128.0"
  }
}
