# copy to worker/.dev.vars (gitignored) and fill in
# ONE of these. The API key is long-lived; the OAuth token is short-lived and
# comes from `ant auth login` (see README) — preferred locally so no permanent
# key sits on disk.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=
# fine-grained PAT, Contents: Read ONLY
GITHUB_TOKEN=

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) at
# console.cloud.google.com → APIs & Services → Credentials, and add
#   http://localhost:8787/api/auth/google/callback
# as an Authorised redirect URI. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
