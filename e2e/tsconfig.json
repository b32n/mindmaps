{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts"],
  // Runs inside the Worker runtime: typed by worker/tsconfig.json instead.
  "exclude": ["./support/google-entry.ts"]
}
